AI_PROVIDER=litellm

GEMINI_API_KEY=TU_API_KEY_AQUI
LITELLM_API_BASE=

PLANNER_MODEL=gemini/gemini-3.5-flash-lite
DIAGRAM_MODEL=gemini/gemini-3.5-flash-lite
SUGGESTION_MODEL=gemini/gemini-3.5-flash-lite
VALIDATION_MODEL=gemini/gemini-3.5-flash-lite
CODEGEN_MODEL=gemini/gemini-3.5-flash-lite
IMAGE_MODEL=gemini/gemini-3.5-flash-lite
IMAGE_FALLBACK_MODELS=

IMAGE_MAX_BYTES=10485760

BACKEND_API_URL=https://backendcopia-software.onrender.com
FRONTEND_URL=https://frontend-copia-software.vercel.app
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_API_KEY=ollama
OLLAMA_CONTEXT_SIZE=8192
OLLAMA_PLAN_TOKENS=1536
AI_REQUEST_TIMEOUT=180

# Desarrollo: direct. Servicio IA desplegado con worker: worker.
OLLAMA_TRANSPORT=direct
# Se generan con: python -m worker_local.setup. No compartir ni subir a Git.
OLLAMA_WORKER_TOKEN=
OLLAMA_BRIDGE_TOKEN=
# Dejar vacío en Render: se calcula usando su variable PORT.
OLLAMA_BRIDGE_BASE_URL=
OLLAMA_WORKER_STALE_SECONDS=45
OLLAMA_WORKER_MAX_PENDING=8
